# MedRAG environment variables
# Copy to .env for Docker Compose, or backend/.env for native development.

# Groq API key used by the chat and evaluation flows
GROQ_API_KEY=gsk_******************************

# Optional model override for the Groq chat path
GROQ_MODEL=llama-3.1-8b-instant

# Optional base URL for the evaluation script to call the backend
MEDRAG_API_URL=http://127.0.0.1:8000

# Required in production. Generate with: openssl rand -hex 32
MEDRAG_API_KEY=
APP_ENV=development
RETAIN_UPLOADS=false
MAX_UPLOAD_BYTES=10485760
MAX_TEXT_CHARS=2000000
MAX_PDF_PAGES=500
MAX_CORPUS_CHUNKS=20000
MAX_CONCURRENT_REQUESTS=4
LLM_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
